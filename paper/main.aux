\newlabel{lst:rir-grammar}{{9}{41}{Abstract grammar of the RIR 0.3 object model. $X^{*}$ denotes an ordered immutable tuple (possibly empty); \texttt {null} marks an absent body or an unused field; \texttt {name} matches \texttt {[A-Za-z\_][A-Za-z0-9\_]*}. Shape only: alias-freedom, control protection, call matching, and numeric ranges are enforced by the semantic validator (\secref {sec:rir})}{lstlisting.9}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {9}{\ignorespaces Abstract grammar of the RIR 0.3 object model. $X^{*}$ denotes an ordered immutable tuple (possibly empty); \texttt  {null} marks an absent body or an unused field; \texttt  {name} matches \texttt  {[A-Za-z\_][A-Za-z0-9\_]*}. Shape only: alias-freedom, control protection, call matching, and numeric ranges are enforced by the semantic validator (Section~\ref {sec:rir}).}}{41}{lstlisting.9}\protected@file@percent }
\newlabel{lst:rir-json}{{10}{41}{Canonical RIR 0.3 JSON (verbatim \texttt {dumps} output) of the module \texttt {h1\{q: Bits(1)\}} containing one \texttt {h}. All fields are written, including nulls and empty tuples; keys are sorted}{lstlisting.10}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {10}{\ignorespaces Canonical RIR 0.3 JSON (verbatim \texttt  {dumps} output) of the module \texttt  {h1\{q: Bits(1)\}} containing one \texttt  {h}. All fields are written, including nulls and empty tuples; keys are sorted.}}{41}{lstlisting.10}\protected@file@percent }
