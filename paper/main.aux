\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Verification status by component. ``Structure'' = L1 validity, serialization, contract checks; ``witness'' = L2/L3 classical witnesses and catalog reproducibility; ``native circuits'' = L4 real-backend amplitude agreement of assembled circuits; ``numerical certification'' = solution-accuracy and success-channel checks against mathematical references in the campaign of Section~\ref {sec:numverify} (register-exact scale; scaling studies remain open). A dash means \emph  {not yet performed}, not impossible.}}{60}{table.caption.52}\protected@file@percent }
\newlabel{tab:status-matrix}{{8}{60}{Verification status by component. ``Structure'' = L1 validity, serialization, contract checks; ``witness'' = L2/L3 classical witnesses and catalog reproducibility; ``native circuits'' = L4 real-backend amplitude agreement of assembled circuits; ``numerical certification'' = solution-accuracy and success-channel checks against mathematical references in the campaign of \secref {sec:numverify} (register-exact scale; scaling studies remain open). A dash means \emph {not yet performed}, not impossible}{table.caption.52}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Numerical-verification campaign: thirteen groups, 475 experiments, all passing their stated criteria on real backends. Paths: O = OriginIR-ext + UnifiedQuantum full amplitudes (incl.\ \texttt  {to\_matrix}); P = PySparQ RIR sparse-state execution; X = cross-checked against the reference executor and the event adapter. Headlines quote the worst-case metric over the group's instances.}}{61}{table.caption.53}\protected@file@percent }
\newlabel{tab:verify-matrix}{{9}{61}{Numerical-verification campaign: thirteen groups, 475 experiments, all passing their stated criteria on real backends. Paths: O = OriginIR-ext + UnifiedQuantum full amplitudes (incl.\^^M\texttt {to\_matrix}); P = PySparQ RIR sparse-state execution; X = cross-checked against the reference executor and the event adapter. Headlines quote the worst-case metric over the group's instances}{table.caption.53}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Resource-scaling study at the Toffoli+Clifford+T+QRAM level (\texttt  {tools/build\_resource\_estimates.py}; JSON artifacts in \texttt  {out/resource-estimates/}). ``rot.'' counts rotations pending synthesis ($\approx 100$ $T$ each at $\epsilon =10^{-10}$ \cite  {ross2016optimal}); ``Q'' counts QRAM queries. The last column states the theoretical expectation; fitted log--log slopes are quoted where the regime is polynomial.}}{62}{table.caption.55}\protected@file@percent }
\newlabel{tab:resource-scaling}{{10}{62}{Resource-scaling study at the Toffoli+Clifford+T+QRAM level (\texttt {tools/build\_resource\_estimates.py}; JSON artifacts in \texttt {out/resource-estimates/}). ``rot.'' counts rotations pending synthesis ($\approx 100$ $T$ each at $\epsilon =10^{-10}$ \cite {ross2016optimal}); ``Q'' counts QRAM queries. The last column states the theoretical expectation; fitted log--log slopes are quoted where the regime is polynomial}{table.caption.55}{}}
